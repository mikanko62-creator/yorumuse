# Database Connection (Supabase PostgreSQL or local SQLite)
DATABASE_URL="postgresql://username:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://username:password@host:port/database"

# Session Security (Generate a secure 32+ character random hex string)
SESSION_SECRET="your-super-secret-session-key-minimum-32-characters"

# Bunny.net Storage & CDN (Optional for local dev)
BUNNY_STORAGE_ZONE="your-storage-zone-name"
BUNNY_API_KEY="your-bunny-storage-api-key"
BUNNY_STORAGE_ENDPOINT="storage.bunnycdn.com"
BUNNY_CDN_URL="https://your-zone.b-cdn.net"

# Setup Admin Secret Key
SETUP_ADMIN_KEY="your-secure-setup-admin-bootstrap-key"

