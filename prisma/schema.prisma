generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String
  birthDate    String
  role         String    @default("USER") // USER, MODERATOR, ADMIN
  status       String    @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  avatarUrl    String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  subscriptions Subscription[]
  posts         Post[]
  comments      Comment[]
  chapterComments ChapterComment[]
  likes         Like[]
  reportsFiled  Report[]       @relation("ReporterRelation")
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Content {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String
  thumbnail   String
  trailer     String
  videoUrl    String?
  category    String
  accessLevel String   @default("PUBLIC") // PUBLIC, MEMBER, PREMIUM
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  duration    String?
  views       Int      @default(0)
  likes       Int      @default(0)
  releaseYear Int      @default(2026)
  tags        String?  // JSON string or comma-separated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters    Chapter[]
  likesList   Like[]
}

model Subscription {
  id               String    @id @default(uuid())
  userId           String
  planId           String    // "member_monthly", "member_annual", "vip_premium"
  status           String    @default("FREE") // FREE, ACTIVE, CANCELLED, EXPIRED, PAST_DUE
  currentPeriodEnd DateTime?
  cancelAtEnd      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id         String   @id @default(uuid())
  authorId   String
  title      String
  content    String
  media      String?
  category   String   @default("Discussions")
  status     String   @default("PUBLISHED") // PUBLISHED, DRAFT, HIDDEN, REMOVED, UNDER_REVIEW
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  status    String   @default("PUBLISHED") // PUBLISHED, HIDDEN, REMOVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  postId    String?
  contentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, contentId])
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  targetType  String   // POST, COMMENT, USER, CONTENT
  targetId    String
  reason      String   // UNDERAGE_SUSPICION, NON_CONSENSUAL, HARASSMENT, SPAM, COPYRIGHT, OTHER
  details     String?
  status      String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  adminNotes  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User @relation("ReporterRelation", fields: [reporterId], references: [id], onDelete: Cascade)
}

model Chapter {
  id            String           @id @default(uuid())
  contentId     String
  chapterNumber Int
  title         String
  description   String?
  thumbnail     String?
  videoUrl      String
  duration      String?
  published     Boolean          @default(true)
  views         Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  content       Content          @relation(fields: [contentId], references: [id], onDelete: Cascade)
  comments      ChapterComment[]

  @@unique([contentId, chapterNumber])
}

model ChapterComment {
  id        String   @id @default(uuid())
  chapterId String
  authorId  String
  content   String
  status    String   @default("PUBLISHED") // PUBLISHED, HIDDEN, REMOVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model HeroSlide {
  id               String   @id @default(uuid())
  title            String
  subtitle         String?
  badge            String?  @default("Exclusive Premiere")
  category         String?  @default("YoruMuse Originals")
  thumbnail        String
  trailerUrl       String?
  contentSlug      String?
  ctaPrimaryText   String?  @default("Nonton Sekarang")
  ctaPrimaryLink   String?  @default("/content")
  ctaSecondaryText String?  @default("Lihat Trailer")
  order            Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
